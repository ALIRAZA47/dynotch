#!/bin/bash
# Sends commands to Dynotch. Most go through its dynotch:// URL scheme. Those that
# have to hear back use the app's local socket, through the app's own binary.
#
#   dynotch notify TEXT [--detail TEXT] [--symbol SF_SYMBOL] [--tint COLOR] [--seconds N]
#                       [--button TITLE --url https://...] [--key NAME]
#                       [--terminal NAME] [--session ID] [--tty PATH] [--folder PATH] [--bundle ID]
#   dynotch open [home|tray|focus|stats|agents]
#   dynotch close
#   dynotch timer [start|pause|toggle|reset|skip]
#   dynotch tray [--show] FILE...
#   dynotch profile NAME
#   dynotch capture
#   dynotch progress NAME [PERCENT|done|fail|clear] [--detail TEXT] [--symbol SF_SYMBOL]
#                         [--tint COLOR] [--quiet-after SECONDS] [--button TITLE --url https://...]
#   dynotch status [--json]
#   dynotch ci [--repo OWNER/NAME] [--branch NAME] [--sha SHA] [--stop]
#
# COLOR is red, orange, yellow, green, mint, teal, cyan, blue, indigo, purple,
# pink, white or gray, or a hex value such as #FF6B5C. A notice from here carries
# a small terminal badge, so it can't pass for one of Dynotch's own. Tray items
# point at the files where they are; nothing under ~/Library is taken. A progress
# line is keyed by NAME, and goes away if its script is quiet for two minutes.
# --terminal and the options after it say where a command ran, for a button on the
# notice that goes back there. A terminal Dynotch doesn't know gets no button.
set -euo pipefail

usage() {
    sed -n '5,25p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

# Percent-encodes every byte, which any URL parser decodes.
encode() { printf '%s' "$1" | od -An -tx1 -v | tr -d ' \n' | sed 's/../%&/g'; }

# -g keeps whatever app you're in at the front.
send() { open -g "dynotch://$1"; }

# The app's binary, which sits one folder over from this script inside Dynotch.app. Called through a
# link on your PATH, $0 is the link. Never a binary found anywhere else: an older Dynotch doesn't
# know --cli, and would start up as a second copy of the app.
binary() {
    if [ -n "${DYNOTCH_BIN:-}" ]; then
        printf '%s' "$DYNOTCH_BIN"
        return
    fi
    local self
    self="$(readlink -f "$0")"
    local beside
    beside="$(dirname "$self")/../MacOS/Dynotch"
    if [ -x "$beside" ]; then
        printf '%s' "$beside"
    else
        echo "dynotch: this command only works from inside Dynotch.app" >&2
        exit 1
    fi
}

[ $# -gt 0 ] || usage 1
command="$1"
shift
case "$command" in
    notify)
        [ $# -gt 0 ] || usage 1
        query="text=$(encode "$1")"
        shift
        while [ $# -gt 0 ]; do
            case "$1" in
                --detail|--symbol|--tint|--seconds|--button|--url|--key|--terminal|--session|--tty|--folder|--bundle)
                    [ $# -gt 1 ] || usage 1
                    query+="&${1#--}=$(encode "$2")"
                    shift 2 ;;
                *) usage 1 ;;
            esac
        done
        send "notify?$query" ;;
    open)
        send "open?tab=$(encode "${1:-home}")" ;;
    close)
        send "close" ;;
    timer)
        case "${1:-toggle}" in
            start|pause|toggle|reset|skip) send "timer/${1:-toggle}" ;;
            *) usage 1 ;;
        esac ;;
    tray)
        query=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --show) query+="&show=1" ;;
                *)
                    [ -e "$1" ] || { echo "dynotch: no such file: $1" >&2; exit 1; }
                    path="$(cd "$(dirname "$1")" && pwd -P)/$(basename "$1")"
                    case "$path" in
                        "$HOME/Library/"*) echo "dynotch: Dynotch doesn't take files from ~/Library: $1" >&2; exit 1 ;;
                    esac
                    query+="&path=$(encode "$path")" ;;
            esac
            shift
        done
        [ -n "$query" ] || usage 1
        send "tray/add?${query#&}" ;;
    profile)
        [ $# -eq 1 ] && [ -n "$1" ] || usage 1
        send "profile?name=$(encode "$1")" ;;
    capture)
        send "capture" ;;
    progress|status|statusline|hook|ci)
        program="$(binary)"
        exec "$program" --cli "$command" "$@" ;;
    -h|--help|help)
        usage ;;
    *)
        usage 1 ;;
esac
