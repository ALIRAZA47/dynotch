---
import Badge from '../components/Badge.astro';
import Keys from '../components/Keys.astro';
import NotchStage from '../components/NotchStage.astro';
import { getPageNames, nav } from '../data/nav';
import { getLatest } from '../data/site';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
const { version, download } = await getLatest();
const names = await getPageNames();

const sizes = [
  {
    title: 'Closed',
    file: 'card-closed',
    alt: 'The closed notch counting down a focus timer.',
    text: 'Live activities sit beside the camera: what’s playing, a timer, a download’s ring, who just wrote.',
  },
  {
    title: 'Glance',
    file: 'card-glance',
    alt: 'The glance on a track, with play and skip buttons.',
    text: 'Rest the pointer on the notch to see what’s live, with a control or two.',
  },
  {
    title: 'Open',
    file: 'card-open',
    alt: 'The open notch on the Nook tab.',
    text: null,
  },
];

const commands = ['tea 4m', 'note Buy coffee', 'remind Call Sam 5pm', '18% of 240', '5 km to mi', 'dark'];
---

<Base title="Dynotch: your MacBook’s notch, put to work" description="Music, files, your calendar, a focus timer and more, one hover away. A free, native notch app for macOS.">
  <main class="home" id="content">
    <div class="home-light"></div>

    <section class="wrap hero" aria-labelledby="hero-title">
      <h1 id="hero-title">Your MacBook’s notch,<br /> put to work.</h1>
      <div class="hero-side">
        <p>Music, files, your calendar, a focus timer and more, one hover away. Native, free and open source.</p>
        <div class="hero-cta">
          <div class="hero-actions">
            <a class="button jewel" href={download}>
              <svg aria-hidden="true" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 2v8.5M4.2 7 8 10.8 11.8 7M2.5 14h11"></path>
              </svg>
              Download for Mac
            </a>
            <a class="button control" href={`${base}install/`}>Read the docs</a>
          </div>
          <p class="hero-meta">Version {version}. Needs macOS 14 or later.</p>
        </div>
      </div>
    </section>

    <NotchStage />

    <section class="wrap section" aria-labelledby="sizes">
      <h2 id="sizes">Three sizes of the same notch.</h2>
      <p class="section-lede">It stays out of the way until you want it, and it only grows as far as you ask.</p>
      <div class="sizes">
        {
          sizes.map(({ title, file, alt, text }) => (
            <article class="size-card pane">
              <div class="size-card-art">
                <img src={`${base}screens/${file}.webp`} {alt} loading="lazy" decoding="async" />
              </div>
              <h3>{title}</h3>
              {text ? (
                <p>{text}</p>
              ) : (
                <p>
                  Click, swipe down or press <Keys k="⌃⌥N" /> for all four tabs. Swipe up, click away or move off it to close it.
                </p>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <section class="wrap section split" aria-labelledby="command">
      <div>
        <h2 id="command">Say it in a few keys.</h2>
        <p class="section-lede">Press <Keys k="⌃⌥K" /> anywhere and type. Timers, notes, reminders, toggles and sums all start in the same field.</p>
        <div class="chips">{commands.map((command) => <span class="chip control">{command}</span>)}</div>
        <a class="text-link" href={`${base}command-field/`}>Everything the field understands</a>
      </div>
      <div class="shot-plain">
        <img src={`${base}screens/command-2-timer.webp`} width="1568" height="536" alt="The command field with tea 4m typed in, offering to start a four minute timer." loading="lazy" decoding="async" />
      </div>
    </section>

    <section class="wrap section split" aria-labelledby="scripting">
      <div>
        <div class="terminal pane">
          <pre><b>dynotch</b> notify "Done" \
  --detail "make test · 2m 14s" \
  --symbol checkmark.circle.fill \
  --tint green</pre>
        </div>
        <div class="notice-art">
          <img src={`${base}screens/65-closed-script-notice.webp`} alt="The closed notch showing Done, make test, 2 minutes 14 seconds, with a small terminal badge." loading="lazy" decoding="async" />
        </div>
      </div>
      <div>
        <h2 id="scripting">Let your scripts use it too.</h2>
        <p class="section-lede">The <code>dynotch</code> command and <code>dynotch://</code> links show notices, open tabs, run the timer, fill the Tray and switch profiles.</p>
        <a class="text-link" href={`${base}dynotch-command/`}>Read about scripting</a>
      </div>
    </section>

    <section class="wrap section" aria-labelledby="map">
      <h2 id="map">Find your way around.</h2>
      <div class="map">
        {
          nav.map((group) => (
            <article class="map-card pane">
              <div class="map-card-title">
                <Badge {group} />
                <h3>{group.title}</h3>
              </div>
              <ul>
                {group.pages.map((slug) => (
                  <li>
                    <a href={`${base}${slug}/`}>{names.get(slug)}</a>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="wrap closing" aria-labelledby="closing">
      <h2 id="closing">Put yours to work.</h2>
      <a class="button jewel" href={download}>Download for Mac</a>
    </section>
  </main>
</Base>
