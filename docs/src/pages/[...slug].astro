---
import { getCollection, render } from 'astro:content';
import Keys from '../components/Keys.astro';
import Note from '../components/Note.astro';
import Path from '../components/Path.astro';
import Shot from '../components/Shot.astro';
import Shots from '../components/Shots.astro';
import Table from '../components/Table.astro';
import Doc from '../layouts/Doc.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<Doc slug={entry.id} title={entry.data.title} description={entry.data.description} {headings} open={entry.data.open}>
  <Content components={{ Keys, Note, Path, Shot, Shots, table: Table }} />
</Doc>
