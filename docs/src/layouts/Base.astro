---
import '../styles/global.css';
import type { MarkdownHeading } from 'astro';
import Dock from '../components/Dock.astro';
import DocsSheet from '../components/DocsSheet.astro';
import Icons from '../components/Icons.astro';
import MenuBar from '../components/MenuBar.astro';
import MoreSheet from '../components/MoreSheet.astro';
import Search from '../components/Search.astro';
import { latestReleaseURL, repositoryURL } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** The page's slug, on a page of the docs. */
  current?: string;
  section?: string;
  /** The page's sections, for the phone's More sheet. */
  headings?: MarkdownHeading[];
}

const { title, description, current, section, headings } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(`${base}social.png`, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dynotch" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Before the first paint, so a light page never flashes dark.
      (() => {
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        document.documentElement.dataset.theme =
          theme ?? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        // On a phone the browser's bar takes this color. The home page starts on the black notch.
        const light = document.documentElement.dataset.theme === 'light' && location.pathname.split('/').length > 3;
        document.querySelector('meta[name="theme-color"]').content = light ? '#f4f2fa' : '#000000';
      })();
    </script>
  </head>
  <body class:list={{ 'is-home': !current }}>
    <a class="skip" href="#content">Skip to the content</a>
    <Icons />
    <MenuBar {current} {section} ring={Boolean(current)} />
    <slot />

    <footer class="footer">
      <div class="footer-inner">
        <span>Dynotch is MIT licensed. Inspired by NotchNook and MacNotch.</span>
        <nav aria-label="Footer">
          <a href={repositoryURL}>GitHub</a>
          <a href={latestReleaseURL}>Releases</a>
          <a href={`${repositoryURL}/blob/main/.github/SECURITY.md`}>Security</a>
          <a href={`${repositoryURL}/blob/main/.github/CONTRIBUTING.md`}>Contributing</a>
        </nav>
      </div>
    </footer>

    <Search />

    <Dock inDocs={Boolean(current)} />
    <DocsSheet {current} />
    <MoreSheet {headings} />

    <script>
      const root = document.documentElement;

      function setTheme(theme: string) {
        root.dataset.theme = theme;
        try {
          localStorage.setItem('theme', theme);
        } catch {
          // Without storage it just lasts until the next page.
        }
        showTheme();
      }

      function showTheme() {
        for (const button of document.querySelectorAll<HTMLElement>('[data-set-theme]')) {
          button.setAttribute('aria-pressed', String(button.dataset.setTheme === root.dataset.theme));
        }
      }

      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
      });

      for (const button of document.querySelectorAll<HTMLElement>('[data-set-theme]')) {
        button.addEventListener('click', () => setTheme(button.dataset.setTheme!));
      }

      showTheme();

      for (const button of document.querySelectorAll<HTMLElement>('[data-open-sheet]')) {
        button.addEventListener('click', () => {
          document.querySelector<HTMLDialogElement>(`#${button.dataset.openSheet}`)?.showModal();
        });
      }

      for (const sheet of document.querySelectorAll<HTMLDialogElement>('.sheet')) {
        sheet.addEventListener('click', (event) => {
          const target = event.target as HTMLElement;
          // A click on the dim area lands on the dialog itself, and a link leaves the sheet behind.
          if (target === sheet || target.closest('[data-close-sheet], a')) sheet.close();
        });
      }

      // A wider window has the menu bar back, so the sheets have nothing left to do.
      matchMedia('(min-width: 861px)').addEventListener('change', (event) => {
        if (event.matches) document.querySelectorAll<HTMLDialogElement>('.sheet').forEach((sheet) => sheet.close());
      });

      // The dock tucks away as you read, and comes back as soon as you scroll up.
      const dock = document.querySelector<HTMLElement>('[data-dock]')!;
      let lastScroll = scrollY;
      addEventListener(
        'scroll',
        () => {
          if (Math.abs(scrollY - lastScroll) < 8) return;
          const atEnd = scrollY + innerHeight >= root.scrollHeight - 40;
          dock.classList.toggle('tucked', scrollY > lastScroll && scrollY > 120 && !atEnd);
          lastScroll = scrollY;
        },
        { passive: true },
      );
    </script>
  </body>
</html>
