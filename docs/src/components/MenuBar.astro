---
import { getLatest, repositoryURL } from '../data/site';
import Keys from './Keys.astro';

interface Props {
  /** The page's slug, for marking where you are. */
  current?: string;
  section?: string;
  /** Show how far down the page you've read, as a ring in the notch. */
  ring?: boolean;
}

const { current, section, ring = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const { download } = await getLatest();
const inScripting = section === 'Automate';
const inChangelog = current === 'changelog';
---

<header class="menubar">
  <nav class="menubar-left" aria-label="Main">
    <a class="brand" href={base}>
      <img src={`${base}icon.png`} alt="" width="24" height="24" />
      <span>Dynotch</span>
    </a>
    <div class="menubar-links">
      <a class="quiet" href={`${base}install/`} aria-current={current && !inScripting && !inChangelog ? 'true' : undefined}>Docs</a>
      <a class="quiet" href={`${base}dynotch-command/`} aria-current={inScripting ? 'true' : undefined}>Scripting</a>
      <a class="quiet" href={`${base}changelog/`} aria-current={inChangelog ? 'true' : undefined}>Changelog</a>
    </div>
  </nav>

  <button class="notch" type="button" data-open-search aria-label="Search the docs" aria-keyshortcuts="Control+Alt+K Meta+K">
    {
      ring ? (
        <svg class="ring" aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke-width="2" stroke-linecap="round">
          <circle class="ring-track" cx="9" cy="9" r="7" />
          <circle class="ring-fill" cx="9" cy="9" r="7" data-reading-ring />
        </svg>
      ) : (
        <svg aria-hidden="true" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <circle cx="7" cy="7" r="4.6" />
          <path d="M10.6 10.6 14 14" />
        </svg>
      )
    }
    <span class="notch-label">Search the docs</span>
    <Keys k="⌃⌥K" />
  </button>

  <div class="menubar-right">
    <a class="quiet" href={repositoryURL}>GitHub</a>
    <button class="icon-button quiet" type="button" data-theme-toggle aria-label="Switch between light and dark">
      <svg class="only-dark" aria-hidden="true" width="17" height="17" viewBox="0 0 18 18" fill="currentColor">
        <path d="M15.4 11.3A6.9 6.9 0 0 1 6.7 2.6a7 7 0 1 0 8.7 8.7Z"></path>
      </svg>
      <svg class="only-light" aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <circle cx="9" cy="9" r="3.4" fill="currentColor" stroke="none"></circle>
        <path d="M9 1.5v1.6M9 14.9v1.6M1.5 9h1.6M14.9 9h1.6M3.7 3.7l1.1 1.1M13.2 13.2l1.1 1.1M3.7 14.3l1.1-1.1M13.2 4.8l1.1-1.1"></path>
      </svg>
    </button>
    <a class="download" href={download}>Download</a>
    <button class="icon-button menu-button" type="button" data-open-menu aria-label="Open the menu">
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <path d="M3 6h14M3 14h14"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  const root = document.documentElement;

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = theme;
    try {
      localStorage.setItem('theme', theme);
    } catch {
      // Without storage it just lasts until the next page.
    }
  });

  const ring = document.querySelector<SVGCircleElement>('[data-reading-ring]');
  if (ring) {
    const length = 2 * Math.PI * 7;
    ring.style.strokeDasharray = `${length}`;
    let queued = false;
    const update = () => {
      queued = false;
      const distance = document.documentElement.scrollHeight - innerHeight;
      const read = distance > 0 ? Math.min(scrollY / distance, 1) : 0;
      ring.style.strokeDashoffset = `${length * (1 - read)}`;
    };
    addEventListener(
      'scroll',
      () => {
        if (!queued) requestAnimationFrame(update);
        queued = true;
      },
      { passive: true },
    );
    update();
  }
</script>
